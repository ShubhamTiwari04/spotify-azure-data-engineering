{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "spotifyadfprojc"
		},
		"spotifyakvLS_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://spotifyKeyVault.vault.azure.net/"
		},
		"azuresqldbLS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifysqlserver.database.windows.net"
		},
		"azuresqldbLS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_spotify"
		},
		"azuresqldbLS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminshubham"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/spotifyakvLS')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('spotifyakvLS_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/azuresqldbLS')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('azuresqldbLS_properties_typeProperties_server')]",
					"database": "[parameters('azuresqldbLS_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('azuresqldbLS_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "spotifyakvLS",
							"type": "LinkedServiceReference"
						},
						"secretName": "spotifydbpassword"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/spotifyakvLS')]"
			]
		}
	]
}
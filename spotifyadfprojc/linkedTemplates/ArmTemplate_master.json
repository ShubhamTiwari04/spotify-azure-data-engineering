{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "spotifyadfprojc"
		},
		"adlsLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adlsLS'"
		},
		"adlsLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datalakespotify.dfs.core.windows.net/"
		},
		"azuresqldbLS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "spotifysqlserver.database.windows.net"
		},
		"azuresqldbLS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_spotify"
		},
		"azuresqldbLS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminshubham"
		},
		"spotifyakvLS_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://spotifyKeyVault.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "spotifyadfprojc_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"adlsLS_accountKey": {
						"value": "[parameters('adlsLS_accountKey')]"
					},
					"adlsLS_properties_typeProperties_url": {
						"value": "[parameters('adlsLS_properties_typeProperties_url')]"
					},
					"spotifyakvLS_properties_typeProperties_baseUrl": {
						"value": "[parameters('spotifyakvLS_properties_typeProperties_baseUrl')]"
					},
					"azuresqldbLS_properties_typeProperties_server": {
						"value": "[parameters('azuresqldbLS_properties_typeProperties_server')]"
					},
					"azuresqldbLS_properties_typeProperties_database": {
						"value": "[parameters('azuresqldbLS_properties_typeProperties_database')]"
					},
					"azuresqldbLS_properties_typeProperties_userName": {
						"value": "[parameters('azuresqldbLS_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}